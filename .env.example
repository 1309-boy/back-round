# Set these in your hosting provider. npm start does not load this file automatically.
PORT=2567
# A long random string keeps guest sessions valid across server restarts.
SESSION_SECRET=replace-with-a-long-random-secret
# Set 0 for Google-account-only online games. Guests are allowed locally by default.
ALLOW_GUEST=1
# Local guest profile persistence directory. Use a persistent volume in production.
DATA_DIR=./data
# Comma-separated website origins, without trailing slashes.
CORS_ORIGINS=http://localhost:2567,https://YOUR_NAME.github.io
# Enable these when a Firebase project is available.
# FIREBASE_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# Public Firebase WEB config, used only when serving the frontend from the Node server.
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...firebaseapp.com","projectId":"...","appId":"..."}
