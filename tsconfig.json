{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noImplicitAny": false,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "esModuleInterop": true, "types": ["node"]
  },
  "include": ["src", "shared", "server", "tests"]
}
